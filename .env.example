# Alpine Linux Environment Variables
# Copy this file to .env and modify values as needed

# System Configuration
ALPINE_VERSION=3.18
TIMEZONE=UTC
LANG=en_US.UTF-8

# Shell and Editor Configuration
EDITOR=vi
SHELL=/bin/ash

# Development Environment
NODE_ENV=development
DEBUG=false
LOG_LEVEL=info

# Optional Development Variables
# Uncomment and modify as needed for your project

# PORT=3000
# HOST=0.0.0.0
# DATABASE_URL=
# API_KEY=
# CACHE_TTL=3600

